.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Local state, crash data, and generated test/report output.
*.db
*.sqlite
*.sqlite3
*.dmp
*.core
coverage/
.nyc_output/
playwright-report/
test-results/
screenshots/
recordings/
