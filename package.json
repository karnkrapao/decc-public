{
  "name": "decc",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first desktop developer control center",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "verify:metadata": "node scripts/check-release-metadata.mjs",
    "verify:source": "node scripts/check-source-integrity.mjs",
    "verify:frontend": "pnpm test && pnpm build",
    "verify:native": "cargo test --manifest-path src-tauri/Cargo.toml && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo build --manifest-path src-tauri/Cargo.toml",
    "verify": "pnpm verify:metadata && pnpm verify:source && pnpm verify:frontend && pnpm verify:native",
    "release:preflight:macos": "pnpm verify && pnpm tauri build --bundles app,dmg && bash scripts/check-macos-bundle.sh",
    "release:verify-signed:macos": "DECC_REQUIRE_DISTRIBUTION_SIGNING=1 bash scripts/check-macos-bundle.sh",
    "release:preflight:windows": "pnpm verify && pnpm tauri build --bundles nsis && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-windows-bundle.ps1",
    "release:verify-signed:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-windows-bundle.ps1 -RequireDistributionSigning",
    "release:smoke:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-windows-installer.ps1",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  }
}
